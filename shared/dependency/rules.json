    { "port": "6380",  "system": "redis" },
    { "port": "11211", "system": "memcached" },
    { "port": "27017", "system": "mongodb" },
    { "port": "27018", "system": "mongodb" },
    { "port": "27019", "system": "mongodb" },
    { "port": "9042",  "system": "cassandra" },
    { "port": "9142",  "system": "cassandra" },
    { "port": "8123",  "system": "clickhouse" },
    { "port": "9440",  "system": "clickhouse" },
    { "port": "9200",  "system": "elasticsearch" },
    { "port": "9300",  "system": "elasticsearch" },
    { "port": "5984",  "system": "couchdb" },
    { "port": "8091",  "system": "couchbase" },
    { "port": "7687",  "system": "neo4j" },
    { "port": "8086",  "system": "influxdb" },

    { "port": "9092",  "system": "kafka" },
    { "port": "9093",  "system": "kafka" },
    { "port": "9094",  "system": "kafka" },
    { "port": "29092", "system": "kafka" },
    { "port": "39092", "system": "kafka" },
    { "port": "5671",  "system": "rabbitmq" },
    { "port": "5672",  "system": "rabbitmq" },
    { "port": "15671", "system": "rabbitmq" },
    { "port": "15672", "system": "rabbitmq" },
    { "port": "4222",  "system": "nats" },
    { "port": "6650",  "system": "pulsar" },
    { "port": "61616", "system": "activemq" },

    { "port": "2379",  "system": "etcd" },
    { "port": "8500",  "system": "consul" },

    { "port": "8200",  "system": "apm",        "hostContains": ["apm"] },
    { "port": "8200",  "system": "vault" },
    { "port": "8201",  "system": "vault" },

    { "port": "9000",  "system": "clickhouse", "hostContains": ["clickhouse"] },
    { "port": "9000",  "system": "minio",      "hostContains": ["minio", "s3"] },
    { "port": "9001",  "system": "minio",      "hostContains": ["minio", "s3"] },

    { "port": "8000",  "system": "kong",       "hostContains": ["kong"] },
    { "port": "8443",  "system": "kong",       "hostContains": ["kong"] },
    { "port": "8001",  "system": "kong",       "hostContains": ["kong"] },
    { "port": "8444",  "system": "kong",       "hostContains": ["kong"] }
  ],

  "hosts": [],

  "internalSuffixes": [
    ".local",
    ".svc",
    ".svc.cluster.local",
    ".cluster.local",
    ".internal",
    ".localdomain"
  ],

  "privateCIDRs": [
