{
  "_comment": [
    "Default dependency-classification ruleset. Override the whole file by",
    "pointing KUBETRACE_DEPENDENCY_RULES at a mounted copy (see the",
    "dependencyRules value in the crnet-apm-monitoring chart).",
    "",
    "scope 'host' restricts a match to peer host names, which is where short or",
    "generic tokens like 'db' are trustworthy; in a span name they are not.",
    "Ports that are widely used by non-database software (8000, 9000, 8443)",
    "require a hostContains hint rather than matching on the number alone."
  ],

  "systems": [
    { "id": "postgresql",    "kind": "database",      "substrings": ["postgresql", "postgres", "pgbouncer", "pgpool", "citus"], "tokens": ["pg", "psql", "pgsql"] },
    { "id": "mysql",         "kind": "database",      "substrings": ["mysql", "percona"] },
    { "id": "mariadb",       "kind": "database",      "substrings": ["mariadb", "galera"] },
    { "id": "mssql",         "kind": "database",      "substrings": ["sqlserver", "mssql", "sql-server"] },
    { "id": "oracle",        "kind": "database",      "substrings": ["oracle"] },
    { "id": "db2",           "kind": "database",      "substrings": ["db2"] },
    { "id": "cockroachdb",   "kind": "database",      "substrings": ["cockroach"] },
    { "id": "clickhouse",    "kind": "database",      "substrings": ["clickhouse"] },
    { "id": "cassandra",     "kind": "database",      "substrings": ["cassandra", "scylla"] },
    { "id": "mongodb",       "kind": "database",      "substrings": ["mongodb", "mongo"] },
    { "id": "elasticsearch", "kind": "database",      "substrings": ["elasticsearch", "elastic"] },
    { "id": "opensearch",    "kind": "database",      "substrings": ["opensearch"] },
    { "id": "couchbase",     "kind": "database",      "substrings": ["couchbase"] },
    { "id": "couchdb",       "kind": "database",      "substrings": ["couchdb"] },
    { "id": "neo4j",         "kind": "database",      "substrings": ["neo4j"] },
    { "id": "influxdb",      "kind": "database",      "substrings": ["influxdb", "influx"] },
    { "id": "snowflake",     "kind": "database",      "substrings": ["snowflake"] },
    { "id": "trino",         "kind": "database",      "substrings": ["trino", "presto"] },
    { "id": "dynamodb",      "kind": "database",      "substrings": ["dynamodb"] },
    { "id": "cosmosdb",      "kind": "database",      "substrings": ["cosmosdb", "cosmos-db"] },
    { "id": "spanner",       "kind": "database",      "substrings": ["spanner"] },
    { "id": "bigquery",      "kind": "database",      "substrings": ["bigquery"] },
    { "id": "liquibase",     "kind": "database",      "substrings": ["liquibase", "flyway"] },

    { "id": "redis",         "kind": "cache",         "substrings": ["redis"] },
    { "id": "valkey",        "kind": "cache",         "substrings": ["valkey"] },
    { "id": "memcached",     "kind": "cache",         "substrings": ["memcached", "memcache"] },
    { "id": "hazelcast",     "kind": "cache",         "substrings": ["hazelcast"] },

    { "id": "kafka",         "kind": "messaging",     "substrings": ["kafka", "redpanda"] },
    { "id": "rabbitmq",      "kind": "messaging",     "substrings": ["rabbitmq", "amqp"] },
    { "id": "nats",          "kind": "messaging",     "substrings": ["nats"] },
    { "id": "pulsar",        "kind": "messaging",     "substrings": ["pulsar"] },
    { "id": "activemq",      "kind": "messaging",     "substrings": ["activemq", "artemis"] },
    { "id": "sqs",           "kind": "messaging",     "substrings": ["sqs"] },
    { "id": "sns",           "kind": "messaging",     "substrings": ["sns"] },
    { "id": "servicebus",    "kind": "messaging",     "substrings": ["servicebus"] },
    { "id": "pubsub",        "kind": "messaging",     "substrings": ["pubsub"] },
    { "_comment": "Generic unnamed queue. Deliberately has no substrings or tokens: it is only ever assigned when a span proves it is a queue operation without naming the broker, never guessed from a name.",
      "id": "queue",         "kind": "messaging" },

    { "id": "minio",         "kind": "storage",       "substrings": ["minio"] },
    { "id": "s3",            "kind": "storage",       "substrings": ["s3.amazonaws", "amazonaws.com/s3"], "tokens": ["s3"] },
    { "id": "gcs",           "kind": "storage",       "substrings": ["storage.googleapis"] },
    { "id": "azureblob",     "kind": "storage",       "substrings": ["blob.core.windows"] },

    { "id": "nginx",         "kind": "gateway",       "substrings": ["nginx", "ingress-nginx"] },
    { "id": "kong",          "kind": "gateway",       "tokens": ["kong"] },
    { "id": "envoy",         "kind": "gateway",       "substrings": ["envoy"] },
    { "id": "traefik",       "kind": "gateway",       "substrings": ["traefik"] },
    { "id": "haproxy",       "kind": "gateway",       "substrings": ["haproxy"] },

    { "id": "vault",         "kind": "secrets",       "substrings": ["vault"] },
    { "id": "consul",        "kind": "discovery",     "substrings": ["consul"] },
    { "id": "etcd",          "kind": "discovery",     "substrings": ["etcd"] },
    { "id": "apm",           "kind": "observability", "substrings": ["apm-server"], "tokens": ["apm"] },

    { "id": "database",      "kind": "database",      "scope": "host", "tokens": ["db", "sql", "database"] }
  ],

  "ports": [
